    },
    {
      "name": "典型_集約リポジトリ責務",
      "input": {"requested_role": "aggregate_repository"},
      "expected": {"logical_role": "aggregate_repository", "action": "proceed"}
    },
    {
      "name": "典型_外部境界責務",
      "input": {"requested_role": "external_boundary"},
      "expected": {"logical_role": "external_boundary", "action": "proceed"}
