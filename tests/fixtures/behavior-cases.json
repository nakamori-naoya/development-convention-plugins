    },
    {
      "name": "反例_Journey場面なし",
      "input": {"journey_scene": false, "mode": "command", "persistence": true, "rdb_explicitly_excludes": false, "lower_gate_green": true},
      "expected": {"action": "stop", "reason": "journey_scene_missing", "gates": []}
    },
    {
      "name": "負例_下層ゲートが赤",
      "input": {"journey_scene": true, "mode": "command", "persistence": true, "rdb_explicitly_excludes": false, "lower_gate_green": false},
      "expected": {"action": "stop", "reason": "lower_gate_red", "gates": ["acceptance_red"]}
    },
    {
      "name": "境界_永続化資料で対象外",
      "input": {"journey_scene": true, "mode": "command", "persistence": true, "rdb_explicitly_excludes": true, "lower_gate_green": true},
      "expected": {"action": "stop", "reason": "persistence_input_missing", "gates": []}
    },
    {
      "name": "境界_永続化資料の対象内外が不明",
      "input": {"journey_scene": true, "mode": "command", "persistence": true, "lower_gate_green": true},
      "expected": {"action": "stop", "reason": "persistence_scope_unknown", "gates": []}
    }
  ],
  "yagni": [
    {
      "name": "典型_資料とテストが呼ぶ",
