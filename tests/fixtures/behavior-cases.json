    {
      "name": "典型_Query実装責務",
      "input": {"requested_role": "query_implementation", "operation": "list", "mode": "query", "restores_aggregate": false},
      "expected": {"logical_role": "query_implementation", "action": "proceed"}
    },
    {
      "name": "反例_一覧を集約リポジトリへ置く要求",
      "input": {"requested_role": "aggregate_repository", "operation": "list", "mode": "query", "restores_aggregate": true},
      "expected": {"action": "stop", "reason": "query_role_conflict"}
    },
    {
      "name": "反例_件数をドメインへ置く要求",
      "input": {"requested_role": "domain", "operation": "count", "mode": "query", "restores_aggregate": false},
      "expected": {"action": "stop", "reason": "query_role_conflict"}
    },
    {
      "name": "反例_検索で集約を復元するQuery実装",
      "input": {"requested_role": "query_implementation", "operation": "search", "mode": "query", "restores_aggregate": true},
      "expected": {"action": "stop", "reason": "query_role_conflict"}
    },
    {
      "name": "反例_存在確認を集約リポジトリへ置く要求",
      "input": {"requested_role": "aggregate_repository", "operation": "exists", "restores_aggregate": false},
      "expected": {"action": "stop", "reason": "query_role_conflict"}
    },
    {
      "name": "典型_集約Command調整",
      "input": {"requested_role": "aggregate_command_coordination", "operation": "command", "mode": "command", "reads_other_aggregate": true, "writes_aggregates": 1},
      "expected": {"logical_role": "aggregate_command_coordination", "action": "proceed"}
    },
    {
      "name": "典型_複数集約調整",
      "input": {"requested_role": "cross_aggregate_command_coordination", "operation": "command", "mode": "command", "writes_aggregates": 2, "expected_time_gap": false},
      "expected": {"logical_role": "cross_aggregate_command_coordination", "consistency": "single_transaction", "action": "proceed"}
    },
    {
      "name": "境界_時間差が明記された変更",
      "input": {"requested_role": "cross_aggregate_command_coordination", "operation": "command", "mode": "command", "writes_aggregates": 2, "expected_time_gap": true},
      "expected": {"logical_role": "cross_aggregate_command_coordination", "consistency": "outbox", "action": "proceed"}
    },
    {
      "name": "負例_DBで集合的制約を宣言できない",
      "input": {"requested_role": "aggregate_command_coordination", "operation": "command", "mode": "command", "writes_aggregates": 1, "collective_constraint": true, "db_declarative_constraint": false},
      "expected": {"action": "stop", "reason": "db_constraint_unavailable"}
    },
    {
      "name": "境界_DBの集合的制約可否が不明",
      "input": {"requested_role": "aggregate_command_coordination", "operation": "command", "mode": "command", "writes_aggregates": 1, "collective_constraint": true},
      "expected": {"action": "stop", "reason": "db_constraint_unknown"}
    },
    {
      "name": "負例_Commandの書き込み集約数が不明",
      "input": {"requested_role": "aggregate_command_coordination", "operation": "command", "mode": "command"},
      "expected": {"action": "stop", "reason": "aggregate_write_count_unknown"}
    },
    {
      "name": "境界_複数集約の時間差が不明",
      "input": {"requested_role": "cross_aggregate_command_coordination", "operation": "command", "mode": "command", "writes_aggregates": 2},
      "expected": {"action": "stop", "reason": "consistency_timing_unknown"}
    },
    {
      "name": "負例_責務が不明",
      "input": {"mode": "command", "writes_aggregates": 1},
      "expected": {"action": "stop", "reason": "responsibility_unknown"}
